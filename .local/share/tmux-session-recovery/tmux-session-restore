#!/usr/bin/env python3
"""Recreate a saved tmux session's agent panes and resume their conversations.

Usage: tmux-session-restore SESSION-NAME
       tmux-session-restore RECORD-DIRECTORY

A plain name selects saves/<session-key>/ beside this script; an argument
containing "/" is a record directory (use ./name for a relative one). Refuses
if a session with the saved name exists. Agents whose directory, command, or
local history is missing are skipped and reported. An agent that fails at
startup stays in its dead pane so the error remains visible.

Exit status: 0 restored, 2 restored with skipped agents, 1 nothing restored or
tmux failed, 64 invalid invocation.
"""
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
from pathlib import Path
from urllib.parse import quote

ROOT = Path(__file__).resolve().parent
SAVES = ROOT / "saves"
UUID_RE = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")
VERSION = 1
PLACEHOLDER = "/bin/sleep 86400"


def session_key(name: str) -> str:
    if not name or "\0" in name:
        raise ValueError("Invalid session name")
    key = quote(name, safe="-_")
    return "%2E" + key[1:] if key.startswith(".") else key


def resume_argv(tool: str, conversation_id: str) -> list:
    if tool == "claude":
        return ["claude", "--resume", conversation_id]
    if tool == "codex":
        return ["codex", "resume", conversation_id]
    raise ValueError("Unsupported agent: " + tool)


def tmux(*args) -> str:
    return subprocess.run(
        ["tmux", *args], check=True, capture_output=True, text=True, timeout=10
    ).stdout.removesuffix("\n")


# Record


def text(value, what: str, absolute: bool = False) -> str:
    if not isinstance(value, str) or not value or "\0" in value:
        raise ValueError(f"Invalid {what}")
    if absolute and not os.path.isabs(value):
        raise ValueError(f"{what} is not absolute: {value!r}")
    return value


def load_state(path: Path) -> dict:
    """Read and strictly validate a version 1 record. Raises ValueError."""
    try:
        state = json.loads(path.read_text(encoding="utf-8"))
    except OSError as e:
        raise ValueError(f"Cannot read {path}: {e.strerror}")
    except ValueError as e:
        raise ValueError(f"{path} is not valid JSON: {e}")
    if not isinstance(state, dict) or state.get("version") != VERSION:
        raise ValueError(f"{path} is not a version {VERSION} recovery record")
    text(state.get("session_name"), "session name")
    windows, skipped = state.get("windows"), state.get("skipped")
    if not isinstance(windows, list) or not isinstance(skipped, list):
        raise ValueError("Record windows and skipped entries must be lists")
    seen = set()
    for window in windows:
        if not isinstance(window, dict) or not isinstance(window.get("agents"), list):
            raise ValueError("Invalid window entry")
        if not isinstance(window.get("name"), str) or "\0" in window["name"]:
            raise ValueError("Invalid window name")  # tmux allows empty names
        for agent in window["agents"]:
            if not isinstance(agent, dict) or agent.get("tool") not in ("claude", "codex"):
                raise ValueError("Invalid agent entry")
            cid = text(agent.get("conversation_id"), "conversation ID")
            if not UUID_RE.fullmatch(cid):
                raise ValueError(f"Invalid conversation ID: {cid!r}")
            text(agent.get("cwd"), "directory", absolute=True)
            text(agent.get("transcript_path"), "transcript path", absolute=True)
            if (agent["tool"], cid) in seen:
                raise ValueError(f"Conversation listed twice: {cid}")
            seen.add((agent["tool"], cid))
    for s in skipped:
        if not isinstance(s, dict) or not all(
            isinstance(s.get(k), str) for k in ("window", "pane", "reason")
        ):
            raise ValueError("Invalid skipped entry")
    return state


def record_path(arg: str) -> Path:
    if "/" in arg:
        return Path(arg).expanduser() / "state.json"
    return SAVES / session_key(arg) / "state.json"


# Preflight


def history_problem(agent: dict) -> str:
    """Why the saved conversation's local history is unusable, or ''."""
    cid, path = agent["conversation_id"], agent["transcript_path"]
    if not os.path.isfile(path):
        return f"history missing: {path}"
    if agent["tool"] == "claude":
        return "" if os.path.basename(path) == cid + ".jsonl" else "history is for another conversation"
    try:
        with open(path, encoding="utf-8") as f:
            meta = json.loads(f.readline())
        ok = meta["type"] == "session_meta" and meta["payload"]["id"] == cid
    except (OSError, ValueError, KeyError, TypeError):
        ok = False
    return "" if ok else "history is for another conversation"


def usable_windows(state: dict):
    """Split the record into restorable windows and reasons for skipped agents."""
    windows, problems = [], []
    for window in state["windows"]:
        agents = []
        for agent in window["agents"]:
            problem = (
                "" if shutil.which(agent["tool"]) else f"{agent['tool']} command not found"
            ) or (
                "" if os.path.isdir(agent["cwd"]) else f"directory missing: {agent['cwd']}"
            ) or history_problem(agent)
            if problem:
                problems.append(f"window {window['name']!r} {agent['tool']} "
                                f"{agent['conversation_id']}: {problem}")
            else:
                agents.append(agent)
        if agents:
            windows.append({"name": window["name"], "agents": agents})
    return windows, problems


def session_exists(name: str) -> bool:
    # Exact comparison: tmux targets would prefix-match a similar name.
    result = subprocess.run(
        ["tmux", "list-sessions", "-F", "#{session_name}"],
        capture_output=True, text=True, timeout=10,
    )
    if result.returncode != 0:
        if "no server running" in result.stderr or "error connecting" in result.stderr:
            return False
        raise RuntimeError("tmux list-sessions failed: " + result.stderr.strip())
    return name in result.stdout.splitlines()


# Construction


def start_agent(pane_id: str, agent: dict) -> None:
    """Replace a placeholder pane created by this restore with the agent."""
    command = "exec " + shlex.join(resume_argv(agent["tool"], agent["conversation_id"]))
    tmux("respawn-pane", "-k", "-t", pane_id, "-c", agent["cwd"],
         "-e", "PATH=" + os.environ.get("PATH", ""), command)


def prepare_window(window_id: str, name: str) -> None:
    tmux("set-option", "-w", "-t", window_id, "remain-on-exit", "failed")
    tmux("set-option", "-w", "-t", window_id, "automatic-rename", "off")
    tmux("rename-window", "-t", window_id, name)  # -n "" alone means "unnamed"


def restore_state(state: dict, windows: list) -> str:
    """Build the session from usable windows; return its tmux session ID."""
    session_id = None
    for window in windows:
        first = window["agents"][0]
        fmt = "#{session_id} #{window_id} #{pane_id}"
        if session_id is None:
            out = tmux("new-session", "-d", "-P", "-F", fmt, "-s", state["session_name"],
                       "-n", window["name"], "-x", "240", "-y", "60",
                       "-c", first["cwd"], PLACEHOLDER)
        else:
            out = tmux("new-window", "-d", "-P", "-F", fmt, "-t", session_id + ":",
                       "-n", window["name"], "-c", first["cwd"], PLACEHOLDER)
        session_id, window_id, pane_id = out.split(" ")
        prepare_window(window_id, window["name"])
        start_agent(pane_id, first)
        for agent in window["agents"][1:]:
            # Split the newest pane: tmux inserts after the split pane, keeping order.
            pane_id = tmux("split-window", "-d", "-P", "-F", "#{pane_id}", "-t", pane_id,
                           "-c", agent["cwd"], PLACEHOLDER)
            tmux("select-layout", "-t", window_id, "tiled")
            start_agent(pane_id, agent)
    first_window = tmux("list-windows", "-t", session_id, "-F", "#{window_id}").splitlines()[0]
    tmux("select-window", "-t", first_window)
    return session_id


def main(argv) -> int:
    if argv[1:] in (["-h"], ["--help"]):
        print(__doc__.strip())
        return 0
    if len(argv) != 2 or not argv[1]:
        print("usage: tmux-session-restore SESSION-NAME | RECORD-DIRECTORY", file=sys.stderr)
        return 64
    arg = argv[1]
    try:
        path = record_path(arg)
        state = load_state(path)
        if "/" not in arg and state["session_name"] != arg:
            raise ValueError(f"{path} belongs to session {state['session_name']!r}")
    except ValueError as e:
        print(f"tmux-session-restore: {e}", file=sys.stderr)
        return 1
    name = state["session_name"]

    try:
        if session_exists(name):
            print(f"tmux-session-restore: session {name!r} already exists; "
                  "not restoring it again", file=sys.stderr)
            return 1
    except (RuntimeError, subprocess.SubprocessError, OSError) as e:
        print(f"tmux-session-restore: {e}", file=sys.stderr)
        return 1

    windows, problems = usable_windows(state)
    for s in state["skipped"]:
        problems.insert(0, f"window {s['window']!r} pane {s['pane']} "
                           f"(not saved): {s['reason']}")
    for problem in problems:
        print("SKIPPED: " + problem, file=sys.stderr)
    if not windows:
        print("tmux-session-restore: no usable agents; created nothing", file=sys.stderr)
        return 1

    try:
        session_id = restore_state(state, windows)
    except (subprocess.SubprocessError, OSError, ValueError) as e:
        detail = getattr(e, "stderr", "") or str(e)
        print(f"tmux-session-restore: tmux failed: {detail.strip()}", file=sys.stderr)
        print(f"Any partial session {name!r} is left for inspection.", file=sys.stderr)
        return 1

    count = sum(len(w["agents"]) for w in windows)
    print(f"Restored {count} agent(s) into session {name!r} ({session_id}).")
    status = 2 if problems else 0
    if os.environ.get("TMUX"):
        try:
            tmux("switch-client", "-t", session_id)
        except subprocess.SubprocessError:
            print(f"Attach with: tmux attach-session -t {session_id}")
        return status
    if sys.stdin.isatty():
        sys.stdout.flush()
        if subprocess.call(["tmux", "attach-session", "-t", session_id]) != 0:
            return 1
        return status
    print(f"Attach with: tmux attach-session -t {session_id}")
    return status


if __name__ == "__main__":
    sys.exit(main(sys.argv))
