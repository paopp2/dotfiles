#!/usr/bin/env python3
"""Recreate a saved tmux session's agent panes and resume their conversations.

Usage: tmux-session-restore [--account LABEL] [--keep-pane]
       tmux-session-restore [--account LABEL] [--keep-pane] SESSION-NAME
       tmux-session-restore [--account LABEL] [--keep-pane] RECORD-DIRECTORY

With no argument, pick one of the 50 newest saved sessions with fzf (or list
them when fzf or a terminal is unavailable). A plain name selects
saves/<session-key>/ beside this script; an argument containing "/" is a
record directory (use ./name for a relative one). Refuses
if a session with the saved name exists. Agents whose directory, command, or
local history is missing are skipped and reported. An agent that fails at
startup stays in its dead pane so the error remains visible.

Each Claude agent resumes on the account it was saved from: the default
~/.claude (with CLAUDE_CONFIG_DIR unset) when the record names none, else its
recorded config dir. --account LABEL resumes every Claude agent on the account
whose config dir holds that account-label instead (for example when the saved
account is out of usage): as cc-handover does, the transcript is first copied
into that account's projects dir; if that account already has a newer copy,
nothing is copied and that copy is resumed. Without --account, a Claude agent
is skipped when another account holds a newer copy of its conversation (it
was handed over after the save); the message names the --account to restore
it with. "Newer" means more user and assistant messages, not a later mtime. Codex
agents are unaffected.

Typed into a tmux pane, it closes that pane once the restored session is on
screen; --keep-pane keeps it. The pane also stays open when there is
something in it to read (skipped agents, a failure, or a switch that did not
happen) and when the picker is dismissed. Run by an agent or a script (stdin
is not the pane's terminal), it never closes a pane.

Exit status: 0 restored, 2 restored with skipped agents, 1 nothing restored or
tmux failed, 64 invalid invocation or nothing picked.
"""
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
from pathlib import Path
from urllib.parse import quote

ROOT = Path(__file__).resolve().parent
SAVES = ROOT / "saves"
UUID_RE = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")
# Version 2 adds config_dir to Claude agents; version 1 means the default account.
VERSIONS = (1, 2)
# The default account. It must run with CLAUDE_CONFIG_DIR unset: setting it,
# even to this dir, makes Claude look up a different login.
DEFAULT_CLAUDE_DIR = str(Path.home() / ".claude")
PLACEHOLDER = "/bin/sleep 86400"
PICK_LIMIT = 50  # older saves stay on disk and restore by name


def session_key(name: str) -> str:
    if not name or "\0" in name:
        raise ValueError("Invalid session name")
    key = quote(name, safe="-_")
    return "%2E" + key[1:] if key.startswith(".") else key


def same_path(a: str, b: str) -> bool:
    return os.path.realpath(a) == os.path.realpath(b)


def resume_argv(tool: str, conversation_id: str, config_dir: str = DEFAULT_CLAUDE_DIR) -> list:
    if tool == "claude":
        # Set or clear CLAUDE_CONFIG_DIR explicitly: the pane would otherwise
        # inherit whatever the tmux server's environment holds.
        if same_path(config_dir, DEFAULT_CLAUDE_DIR):
            account = ["env", "-u", "CLAUDE_CONFIG_DIR"]
        else:
            account = ["env", "CLAUDE_CONFIG_DIR=" + config_dir]
        return [*account, "claude", "--resume", conversation_id]
    if tool == "codex":
        # Without the shared daemon the process holds its own conversation lock,
        # which teardown needs to identify it.
        return ["codex", "resume", "--no-daemon", conversation_id]
    raise ValueError("Unsupported agent: " + tool)


def tmux(*args) -> str:
    return subprocess.run(
        ["tmux", *args], check=True, capture_output=True, text=True, timeout=10
    ).stdout.removesuffix("\n")


# Record


def text(value, what: str, absolute: bool = False) -> str:
    if not isinstance(value, str) or not value or "\0" in value:
        raise ValueError(f"Invalid {what}")
    if absolute and not os.path.isabs(value):
        raise ValueError(f"{what} is not absolute: {value!r}")
    return value


def load_state(path: Path) -> dict:
    """Read and strictly validate a version 1 or 2 record. Raises ValueError."""
    try:
        state = json.loads(path.read_text(encoding="utf-8"))
    except OSError as e:
        raise ValueError(f"Cannot read {path}: {e.strerror}")
    except ValueError as e:
        raise ValueError(f"{path} is not valid JSON: {e}")
    if not isinstance(state, dict) or state.get("version") not in VERSIONS:
        raise ValueError(f"{path} is not a version 1 or 2 recovery record")
    text(state.get("session_name"), "session name")
    windows, skipped = state.get("windows"), state.get("skipped")
    if not isinstance(windows, list) or not isinstance(skipped, list):
        raise ValueError("Record windows and skipped entries must be lists")
    seen = set()
    for window in windows:
        if not isinstance(window, dict) or not isinstance(window.get("agents"), list):
            raise ValueError("Invalid window entry")
        if not isinstance(window.get("name"), str) or "\0" in window["name"]:
            raise ValueError("Invalid window name")  # tmux allows empty names
        for agent in window["agents"]:
            if not isinstance(agent, dict) or agent.get("tool") not in ("claude", "codex"):
                raise ValueError("Invalid agent entry")
            cid = text(agent.get("conversation_id"), "conversation ID")
            if not UUID_RE.fullmatch(cid):
                raise ValueError(f"Invalid conversation ID: {cid!r}")
            text(agent.get("cwd"), "directory", absolute=True)
            text(agent.get("transcript_path"), "transcript path", absolute=True)
            if state["version"] >= 2 and agent["tool"] == "claude":
                text(agent.get("config_dir"), "config dir", absolute=True)
            elif "config_dir" in agent:
                raise ValueError("config_dir is only valid on version 2 Claude agents")
            if (agent["tool"], cid) in seen:
                raise ValueError(f"Conversation listed twice: {cid}")
            seen.add((agent["tool"], cid))
    for s in skipped:
        if not isinstance(s, dict) or not all(
            isinstance(s.get(k), str) for k in ("window", "pane", "reason")
        ):
            raise ValueError("Invalid skipped entry")
    return state


def record_path(arg: str) -> Path:
    if "/" in arg:
        return Path(arg).expanduser() / "state.json"
    return SAVES / session_key(arg) / "state.json"


# Preflight


def history_problem(agent: dict) -> str:
    """Why the saved conversation's local history is unusable, or ''."""
    cid, path = agent["conversation_id"], agent["transcript_path"]
    if not os.path.isfile(path):
        return f"history missing: {path}"
    if agent["tool"] == "claude":
        return "" if os.path.basename(path) == cid + ".jsonl" else "history is for another conversation"
    try:
        with open(path, encoding="utf-8") as f:
            meta = json.loads(f.readline())
        ok = meta["type"] == "session_meta" and meta["payload"]["id"] == cid
    except (OSError, ValueError, KeyError, TypeError):
        ok = False
    return "" if ok else "history is for another conversation"


def accounts() -> list:
    """(label, config dir) for each account, found as cc-handover finds them."""
    home = Path.home()
    found = []
    for d in [home / ".claude", *sorted(home.glob(".claude-*"))]:
        try:
            found.append(((d / "account-label").read_text().strip(), str(d)))
        except OSError:
            continue
    return found


def account_dir(label: str) -> str:
    for name, d in accounts():
        if name == label:
            return d
    raise ValueError(f"no account labelled {label!r}")


def account_copy(config_dir: str, transcript: str) -> str:
    """Where another account keeps the same transcript (same project dir)."""
    return os.path.join(config_dir, "projects", os.path.basename(os.path.dirname(transcript)),
                        os.path.basename(transcript))


def messages(path: str) -> int:
    """How far a transcript has got: its user and assistant messages. Not the
    mtime: after a handover the old account's Claude still writes bookkeeping
    lines as it exits, which can leave the stale copy the last one written."""
    count = 0
    with open(path, "rb") as f:
        for line in f:
            try:
                count += json.loads(line).get("type") in ("user", "assistant")
            except (ValueError, AttributeError):
                continue
    return count


def newer_copy(agent: dict, ignore: list) -> str:
    """Why the saved history is stale, or ''. After a later cc-handover another
    account carries the conversation further; resuming the saved copy would
    silently drop those turns."""
    source = agent["transcript_path"]
    try:
        saved = messages(source)
        for label, d in accounts():
            copy = account_copy(d, source)
            if any(same_path(d, i) for i in ignore) or same_path(copy, source):
                continue
            if os.path.isfile(copy) and messages(copy) > saved:
                return (f"account {label!r} has a newer copy of this conversation; "
                        f"restore with --account {label} to continue it there")
    except OSError as e:
        return f"cannot compare history across accounts: {e}"
    return ""


def handover(agent: dict, target: str):
    """Copy a Claude transcript into another account, as cc-handover does.
    Returns the agent as it resumes there, and a problem ('' if none)."""
    source = agent["transcript_path"]
    copy = account_copy(target, source)
    moved = dict(agent, config_dir=target, transcript_path=copy)
    if same_path(copy, source):
        return moved, ""
    try:
        # A target that has since carried the conversation further (a later
        # cc-handover) is resumed as it is: copying over it would throw those
        # turns away. Any turns only the saved copy has stay in its file.
        if os.path.isfile(copy) and messages(copy) > messages(source):
            print(f"NOTE: {agent['conversation_id']}: resuming the further-along copy "
                  f"in {target}; the saved copy was not copied over it", file=sys.stderr)
            return moved, ""
        os.makedirs(os.path.dirname(copy), exist_ok=True)
        shutil.copy2(source, copy)  # keeps the mtime, as cp -p does
    except OSError as e:
        return agent, f"cannot copy history to {target}: {e}"
    return moved, ""


def usable_windows(state: dict, target=None):
    """Split the record into restorable windows and reasons for skipped agents.
    With a target config dir, Claude agents are handed over to it first."""
    windows, problems = [], []
    for window in state["windows"]:
        agents = []
        for agent in window["agents"]:
            problem = (
                "" if shutil.which(agent["tool"]) else f"{agent['tool']} command not found"
            ) or (
                "" if os.path.isdir(agent["cwd"]) else f"directory missing: {agent['cwd']}"
            ) or history_problem(agent)
            if not problem and agent["tool"] == "claude":
                # handover() resumes the target's copy when that is the newer one.
                problem = newer_copy(agent, [target] if target else [])
            if not problem and target and agent["tool"] == "claude":
                agent, problem = handover(agent, target)
            if problem:
                problems.append(f"window {window['name']!r} {agent['tool']} "
                                f"{agent['conversation_id']}: {problem}")
            else:
                agents.append(agent)
        if agents:
            windows.append({"name": window["name"], "agents": agents})
    return windows, problems


def session_exists(name: str) -> bool:
    # Exact comparison: tmux targets would prefix-match a similar name.
    result = subprocess.run(
        ["tmux", "list-sessions", "-F", "#{session_name}"],
        capture_output=True, text=True, timeout=10,
    )
    if result.returncode != 0:
        if "no server running" in result.stderr or "error connecting" in result.stderr:
            return False
        raise RuntimeError("tmux list-sessions failed: " + result.stderr.strip())
    return name in result.stdout.splitlines()


# Picker


def saved_records() -> list:
    """(record directory, state, mtime) for each valid record, newest first."""
    records = []
    for d in SAVES.iterdir() if SAVES.is_dir() else []:
        if d.name.startswith("."):
            continue
        try:
            state = load_state(d / "state.json")
            records.append((d, state, (d / "state.json").stat().st_mtime))
        except (ValueError, OSError):
            continue
    return sorted(records, key=lambda r: r[2], reverse=True)


def pick_record():
    """Record directory chosen with fzf from the newest saved sessions, or None."""
    records = saved_records()
    lines = [d.name + "\t" + " ".join(state["session_name"].split())
             for d, state, _ in records[:PICK_LIMIT]]
    if not lines:
        print(f"No saved sessions in {SAVES}", file=sys.stderr)
        return None
    if not (shutil.which("fzf") and sys.stdin.isatty() and sys.stdout.isatty()):
        print("\n".join(line.split("\t", 1)[1] for line in lines))
        return None
    result = subprocess.run(
        ["fzf", "--reverse", "--no-sort", "--delimiter=\t", "--with-nth=2"],
        input="\n".join(lines) + "\n", stdout=subprocess.PIPE, text=True,
    )
    if result.returncode != 0 or not result.stdout.strip():
        return None
    return str(SAVES / result.stdout.split("\t", 1)[0])


# Construction


def start_agent(pane_id: str, agent: dict) -> None:
    """Replace a placeholder pane created by this restore with the agent."""
    # A version 1 record has no config_dir: it was the default account.
    command = "exec " + shlex.join(resume_argv(
        agent["tool"], agent["conversation_id"],
        agent.get("config_dir", DEFAULT_CLAUDE_DIR)))
    # Set on the pane, not the window: shells opened in the window later
    # should close as usual. An agent that exits normally (status 0) closes too.
    tmux("set-option", "-p", "-t", pane_id, "remain-on-exit", "failed")
    tmux("respawn-pane", "-k", "-t", pane_id, "-c", agent["cwd"],
         "-e", "PATH=" + os.environ.get("PATH", ""), command)


def prepare_window(window_id: str, name: str) -> None:
    tmux("set-option", "-w", "-t", window_id, "automatic-rename", "off")
    tmux("rename-window", "-t", window_id, name)  # -n "" alone means "unnamed"


def restore_state(state: dict, windows: list) -> str:
    """Build the session from usable windows; return its tmux session ID."""
    session_id = None
    for window in windows:
        first = window["agents"][0]
        fmt = "#{session_id} #{window_id} #{pane_id}"
        if session_id is None:
            out = tmux("new-session", "-d", "-P", "-F", fmt, "-s", state["session_name"],
                       "-n", window["name"], "-x", "240", "-y", "60",
                       "-c", first["cwd"], PLACEHOLDER)
        else:
            out = tmux("new-window", "-d", "-P", "-F", fmt, "-t", session_id + ":",
                       "-n", window["name"], "-c", first["cwd"], PLACEHOLDER)
        session_id, window_id, pane_id = out.split(" ")
        prepare_window(window_id, window["name"])
        start_agent(pane_id, first)
        for agent in window["agents"][1:]:
            # Split the newest pane: tmux inserts after the split pane, keeping order.
            pane_id = tmux("split-window", "-d", "-P", "-F", "#{pane_id}", "-t", pane_id,
                           "-c", agent["cwd"], PLACEHOLDER)
            tmux("select-layout", "-t", window_id, "tiled")
            start_agent(pane_id, agent)
    first_window = tmux("list-windows", "-t", session_id, "-F", "#{window_id}").splitlines()[0]
    tmux("select-window", "-t", first_window)
    return session_id


def typed_pane():
    """The tmux pane this was typed into, or None. An agent's shell tool or a
    script also inherits TMUX_PANE, but not the pane's terminal, so only a
    stdin that is the pane's own tty counts: closing an agent's pane would
    kill that agent."""
    pane = os.environ.get("TMUX_PANE")
    if not pane:
        return None
    try:
        tty = os.ttyname(sys.stdin.fileno())
        return pane if tmux("display-message", "-p", "-t", pane, "#{pane_tty}") == tty else None
    except (OSError, subprocess.SubprocessError):
        return None


def close_own_pane(pane: str, status: int) -> int:
    """Close the pane this was typed into, unless it holds skip reports to read."""
    if status != 0:
        print("Not closing this pane: see the skipped agents above.", file=sys.stderr)
        return status
    sys.stdout.flush()
    try:
        # Ends this process too; the client already shows the restored session.
        tmux("kill-pane", "-t", pane)
    except subprocess.SubprocessError as e:
        print(f"tmux-session-restore: could not close this pane: "
              f"{(getattr(e, 'stderr', '') or str(e)).strip()}", file=sys.stderr)
        return 1
    return status


def main(argv) -> int:
    if argv[1:] in (["-h"], ["--help"]):
        print(__doc__.strip())
        return 0
    args, target, keep_pane = argv[1:], None, False
    while args[:1] in (["--account"], ["--keep-pane"]):
        if args[0] == "--keep-pane":
            keep_pane, args = True, args[1:]
            continue
        try:
            if len(args) < 2 or not args[1]:
                raise ValueError("--account needs an account label")
            target = account_dir(args[1])
        except ValueError as e:
            print(f"tmux-session-restore: {e}", file=sys.stderr)
            return 64
        args = args[2:]
    if not args:
        arg = pick_record()
        if arg is None:
            return 64
    elif len(args) != 1 or not args[0]:
        print("usage: tmux-session-restore [--account LABEL] [--keep-pane] "
              "[SESSION-NAME | RECORD-DIRECTORY]", file=sys.stderr)
        return 64
    else:
        arg = args[0]
    try:
        path = record_path(arg)
        state = load_state(path)
        if "/" not in arg and state["session_name"] != arg:
            raise ValueError(f"{path} belongs to session {state['session_name']!r}")
    except ValueError as e:
        print(f"tmux-session-restore: {e}", file=sys.stderr)
        return 1
    name = state["session_name"]

    try:
        if session_exists(name):
            print(f"tmux-session-restore: session {name!r} already exists; "
                  "not restoring it again", file=sys.stderr)
            return 1
    except (RuntimeError, subprocess.SubprocessError, OSError) as e:
        print(f"tmux-session-restore: {e}", file=sys.stderr)
        return 1

    windows, problems = usable_windows(state, target)
    for s in state["skipped"]:
        problems.insert(0, f"window {s['window']!r} pane {s['pane']} "
                           f"(not saved): {s['reason']}")
    for problem in problems:
        print("SKIPPED: " + problem, file=sys.stderr)
    if not windows:
        print("tmux-session-restore: no usable agents; created nothing", file=sys.stderr)
        return 1

    try:
        session_id = restore_state(state, windows)
    except (subprocess.SubprocessError, OSError, ValueError) as e:
        detail = getattr(e, "stderr", "") or str(e)
        print(f"tmux-session-restore: tmux failed: {detail.strip()}", file=sys.stderr)
        print(f"Any partial session {name!r} is left for inspection.", file=sys.stderr)
        return 1

    count = sum(len(w["agents"]) for w in windows)
    print(f"Restored {count} agent(s) into session {name!r} ({session_id}).")
    status = 2 if problems else 0
    if os.environ.get("TMUX"):
        try:
            tmux("switch-client", "-t", session_id)
        except subprocess.SubprocessError:
            print(f"Attach with: tmux attach-session -t {session_id}")
            return status
        pane = None if keep_pane else typed_pane()
        return close_own_pane(pane, status) if pane else status
    if sys.stdin.isatty():
        sys.stdout.flush()
        if subprocess.call(["tmux", "attach-session", "-t", session_id]) != 0:
            return 1
        return status
    print(f"Attach with: tmux attach-session -t {session_id}")
    return status


if __name__ == "__main__":
    sys.exit(main(sys.argv))
