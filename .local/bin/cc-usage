#!/bin/sh
# Show 5-hour and weekly usage for every Claude Code account on this machine.
# usage: cc-usage          print and exit
#        cc-usage --pick   for the tmux popup (Ctrl-q): mark the account the pane's
#                          Claude session is on, and move that session to the
#                          account chosen with Up/Down and Enter
#        cc-usage --best [--not <config dir>]
#                          print the config dir of the account to use next,
#                          or nothing when none has room
#
# An account is a config dir (~/.claude or ~/.claude-*) holding an
# account-label file. Usage comes from ccstatusline, which already knows how
# to read each config dir's login, so no credentials are handled here.
set -eu

tz=$(readlink /etc/localtime | sed 's|.*/zoneinfo/||')
tmp=$(mktemp -d)
esc=$(printf '\033')
nbsp=$(printf '\302\240') # ccstatusline pads with non-breaking spaces
trap 'rm -rf "$tmp"' EXIT

# bunx spends about half a second resolving the package on every call, so run
# the newest copy it has already cached and only fall back to bunx without one.
dist=$(ls "$HOME"/.bun/install/cache/ccstatusline@*/dist/ccstatusline.js 2>/dev/null | sort -V | tail -1)
ccstatusline() {
    if [ -n "$dist" ]; then bun "$dist" "$@"; else bunx -y ccstatusline@latest "$@"; fi
}

widget() { # widget <id> <type> [absolute]
    printf '{"id":"%s","type":"%s","rawValue":true' "$1" "$2"
    [ -n "${3:-}" ] && printf ',"metadata":{"absolute":"true","weekday":"true","timezone":"%s"}' "$tz"
    printf '}'
}
sep() { printf ',{"id":"s%s","type":"separator"},' "$1"; }
# Time until the limit at the current pace. ccstatusline hides it unless the
# limit comes before the reset, so it is tagged instead of read by position.
limit() { printf '{"id":"%s","type":"%s","metadata":{"label":"%s"}}' "$1" "$2" "$3"; }

# usage_line <scratch file> [config dir]; prints six " | " separated fields,
# then "5h=<time>" and "wk=<time>" for any window on pace to run out.
usage_line() {
    {
        printf '{"version":4,"colorLevel":0,"lines":[['
        widget 1 session-usage;            sep 1
        widget 2 reset-timer;              sep 2
        widget 3 reset-timer absolute;     sep 3
        widget 4 weekly-usage;             sep 4
        widget 5 weekly-reset-timer;       sep 5
        widget 6 weekly-reset-timer absolute; sep 6
        limit 7 block-limit-timer 5h=;     sep 7
        limit 8 weekly-limit-timer wk=
        printf '],[],[]]}'
    } > "$1"
    printf '{"session_id":"cc-usage","model":{"display_name":"-"},"cwd":"/"}' |
        if [ -n "${2:-}" ]; then
            CLAUDE_CONFIG_DIR=$2 ccstatusline --config "$1"
        else
            (unset CLAUDE_CONFIG_DIR; ccstatusline --config "$1")
        fi 2>/dev/null | tail -1 | sed "s/$esc\[[0-9;]*m//g; s/$nbsp/ /g"
}

trim() { printf '%s' "$1" | sed 's/^ *//; s/ *$//'; }

# Reduce "2026-11-21 10:39 GMT+8" or "Sun 19:59 GMT+8" to local "10:39" / "Sun 19:59".
clock() { trim "$1" | sed -E 's/^[0-9]{4}-[0-9]{2}-[0-9]{2} //; s/([0-9]{2}:[0-9]{2}).*$/\1/'; }

bar() { # bar <percent>; 20 cells, coloured by level when printing to a terminal
    level=${1%%%}; level=${level%%.*}
    filled=$(( (level * 20 + 50) / 100 )); [ "$filled" -gt 20 ] && filled=20
    if [ "$level" -ge 80 ]; then colour=31; elif [ "$level" -ge 50 ]; then colour=33; else colour=32; fi
    [ -t 1 ] && printf '\033[%sm' "$colour"
    i=0; while [ "$i" -lt "$filled" ]; do printf '█'; i=$((i + 1)); done
    [ -t 1 ] && printf '\033[90m'
    while [ "$i" -lt 20 ]; do printf '░'; i=$((i + 1)); done
    [ -t 1 ] && printf '\033[0m'
    return 0
}

seconds() { # seconds <duration such as "1d 2hr 5m">; 0 for anything else
    secs=0
    for part in $1; do
        case $part in
            *[!0-9]*d | *[!0-9]*hr | *[!0-9]*m) ;;
            *d)  secs=$((secs + ${part%d} * 86400)) ;;
            *hr) secs=$((secs + ${part%hr} * 3600)) ;;
            *m)  secs=$((secs + ${part%m} * 60)) ;;
        esac
    done
    echo "$secs"
}

# out_at <duration>; the local 24-hour clock time that far from now, with the
# weekday when it is not today.
out_at() {
    secs=$(seconds "$1")
    if [ "$(date -v "+${secs}S" +%F)" = "$(date +%F)" ]; then date -v "+${secs}S" +%H:%M
    else date -v "+${secs}S" '+%a %H:%M'; fi
}

window() { # window <name> <percent> <time left> <resets at> <time until the limit, or empty>
    pct=$(trim "$2")
    printf '%s  %-7s ' "$gutter" "$1"; bar "$pct"; printf ' %6s  ' "$pct"
    case $3 in
        *Loading*) printf 'no active window' ;;
        *)         printf 'resets in %s (%s)' "$(trim "$3")" "$(clock "$4")" ;;
    esac
    if [ -n "$5" ]; then
        [ -t 1 ] && printf '\033[31m'
        printf ', out at %s' "$(out_at "$5")"
        [ -t 1 ] && printf '\033[0m'
    fi
    printf '\n'
}

tagged() { # tagged <tag> <text>; the value after "<tag>=" up to the next separator
    printf '%s' "$2" | sed -n "s/.*$1=\([^|]*\).*/\1/p" | sed 's/ *$//'
}

identity() { # identity <login file>; "email (org)", with a one-person org shown as "personal"
    jq -r --arg own "'s Organization" '.oauthAccount // empty |
        "\(.emailAddress) (\(if .organizationName == .emailAddress + $own
                             then "personal" else .organizationName end))"' "$1" 2>/dev/null
}

# best <limit>; the config dir of the account to start or continue a session
# on, among those under <limit> percent in both windows.
#
# An account's surplus is its weekly percent left minus the percent of its week
# left: what an even pace would leave unused at the reset, where it is lost.
# The largest surplus wins once it is worth chasing. Otherwise accounts are
# used in the order listed, the default one first: it is the one whose 5-hour
# windows run out soonest, and a window left idle is lost as well.
chase=20 # surplus, in points, from which an account jumps the order
best() {
    acct=0 best_dir= best_surplus=-101 first_dir=
    while [ "$acct" -lt "$count" ]; do
        acct=$((acct + 1))
        dir=$(cat "$tmp/$acct.dir")
        [ "$dir" != "$skip" ] || continue
        s_pct=
        IFS='|' read -r s_pct s_left s_at w_pct w_left w_at rest < "$tmp/$acct.line" || true
        s_used=$(trim "$s_pct"); s_used=${s_used%%.*}
        w_used=$(trim "$w_pct"); w_used=${w_used%%.*}
        case $s_used$w_used in '' | *[!0-9]*) continue ;; esac # no usage: logged out or offline
        [ "$s_used" -lt "$1" ] && [ "$w_used" -lt "$1" ] || continue
        left=$(seconds "$w_left")
        [ "$left" -gt 0 ] || left=604800 # no weekly window open yet: a full week
        surplus=$(( 100 - w_used - left / 6048 )) # 6048s is a percent of a week
        [ -n "$first_dir" ] || first_dir=$dir
        if [ "$surplus" -gt "$best_surplus" ]; then best_dir=$dir best_surplus=$surplus; fi
    done
    [ -n "$first_dir" ] || return 1
    if [ "$best_surplus" -ge "$chase" ]; then printf '%s\n' "$best_dir"
    else printf '%s\n' "$first_dir"; fi
}

pick= pane= current= gutter= choose= skip=
if [ "${1:-}" = --best ]; then
    choose=1
    [ "${2:-}" = --not ] && skip=${3%/}
fi
if [ "${1:-}" = --pick ]; then
    pick=1
    gutter='  ' # room for the selection marker
    # Inside a tmux popup the active pane is still the one it was opened from.
    pane=$(tmux display-message -p '#{pane_id}')
    current=$(TMUX_PANE=$pane cc-handover --which 2>/dev/null || true)
fi

key() { # key; wait for one keypress and name it: up, down, enter or other
    saved=$(stty -g)
    stty -icanon -echo -ixon min 1 time 0 # -ixon so Ctrl-q arrives as a key
    bytes=$(dd bs=1 count=1 2>/dev/null)
    if [ "$bytes" = "$esc" ]; then
        # An arrow key sends two more bytes at once; a bare Esc sends none.
        stty min 0 time 1
        bytes=$bytes$(dd bs=2 count=1 2>/dev/null)
    fi
    stty "$saved"
    case $bytes in
        "$esc[A" | "${esc}OA" | k) echo up ;;
        "$esc[B" | "${esc}OB" | j) echo down ;;
        '') echo enter ;; # Enter arrives as a newline, which $(...) strips
        *) echo other ;;
    esac
}

# Fetch every account at once, then print in a stable order.
count=0
for dir in "$HOME/.claude" "$HOME"/.claude-*; do
    [ -f "$dir/account-label" ] || continue
    count=$((count + 1))
    # The default dir keeps its login file beside it and must run with
    # CLAUDE_CONFIG_DIR unset: setting it, even to ~/.claude, makes Claude
    # tooling look up a different login.
    if [ "$dir" = "$HOME/.claude" ]; then arg=; login=$HOME/.claude.json
    else arg=$dir; login=$dir/.claude.json; fi
    name=$(identity "$login" || true)
    cp "$dir/account-label" "$tmp/$count.label"
    printf '%s\n' "$dir" > "$tmp/$count.dir"
    printf '%s\n' "${name:-$(cat "$dir/account-label") (not logged in)}" > "$tmp/$count.name"
    usage_line "$tmp/$count.json" "$arg" > "$tmp/$count.line" &
done
wait

if [ -n "$choose" ]; then
    # Prefer an account with real room; one that is nearly out is a last resort.
    best 95 || best 100 || true
    exit 0
fi

heading() { # heading <account number> [selected]; the account's name line, without a newline
    if [ -n "${2:-}" ]; then printf '> \033[7m%s\033[0m' "$(cat "$tmp/$1.name")"
    else printf '%s%s' "$gutter" "$(cat "$tmp/$1.name")"; fi
    if [ -n "$current" ] && [ "$(cat "$tmp/$1.label")" = "$current" ]; then
        printf '  <- this session'
    fi
}

render() { # print every account, noting the screen row of each heading for paint
    acct=0 row=1
    while [ "$acct" -lt "$count" ]; do
        acct=$((acct + 1))
        echo "$row" > "$tmp/$acct.row"
        heading "$acct"
        printf '\n'
        s_pct=
        IFS='|' read -r s_pct s_left s_at w_pct w_left w_at rest < "$tmp/$acct.line" || true
        if [ -z "$s_pct" ]; then
            printf '%s  usage unavailable, run again\n' "$gutter"
            row=$((row + 2))
            continue
        fi
        window 5h "$s_pct" "$s_left" "$s_at" "$(tagged 5h "$rest")"
        window weekly "$w_pct" "$w_left" "$w_at" "$(tagged wk "$rest")"
        row=$((row + 3))
    done
}

# paint <account number> [selected]; redraw only that heading, so moving the
# selection does not repaint the whole popup. The cursor is parked below the list.
paint() {
    printf '\033[%s;1H' "$(cat "$tmp/$1.row")"
    heading "$1" "${2:-}"
    printf '\033[K\033[%s;1H' "$row"
}

if [ -z "$pick" ]; then
    render
    exit 0
fi
if [ -z "$current" ]; then # no Claude session in the pane: nothing to move
    render
    key > /dev/null
    exit 0
fi

# Start on the session's own account, so Enter alone changes nothing.
selected=1
while [ "$(cat "$tmp/$selected.label")" != "$current" ]; do selected=$((selected + 1)); done
printf '\033[H\033[2J'
render
# Up/Down (or k/j) moves the selection, Enter moves the session there, and any
# other key closes.
while :; do
    paint "$selected" selected
    case $(key) in
        up) next=$(( (selected + count - 2) % count + 1 )) ;;
        down) next=$(( selected % count + 1 )) ;;
        enter) break ;;
        *) exit 0 ;;
    esac
    paint "$selected"
    selected=$next
done
label=$(cat "$tmp/$selected.label")
[ "$label" != "$current" ] || exit 0
if ! TMUX_PANE=$pane cc-handover "$label" > /dev/null 2> "$tmp/error"; then
    cat "$tmp/error"
    printf 'Press any key.\n'
    key > /dev/null
fi
