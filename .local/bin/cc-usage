#!/bin/sh
# Show 5-hour and weekly usage for every Claude Code account on this machine.
# usage: cc-usage
#
# An account is a config dir (~/.claude or ~/.claude-*) holding an
# account-label file. Usage comes from ccstatusline, which already knows how
# to read each config dir's login, so no credentials are handled here.
set -eu

tz=$(readlink /etc/localtime | sed 's|.*/zoneinfo/||')
config=$(mktemp)
esc=$(printf '\033')
nbsp=$(printf '\302\240') # ccstatusline pads with non-breaking spaces
trap 'rm -f "$config"' EXIT

widget() { # widget <id> <type> [absolute]
    printf '{"id":"%s","type":"%s","rawValue":true' "$1" "$2"
    [ -n "${3:-}" ] && printf ',"metadata":{"absolute":"true","weekday":"true","timezone":"%s"}' "$tz"
    printf '}'
}
sep() { printf ',{"id":"s%s","type":"separator"},' "$1"; }

usage_line() { # usage_line [config dir]; prints six " | " separated fields
    {
        printf '{"version":4,"colorLevel":0,"lines":[['
        widget 1 session-usage;            sep 1
        widget 2 reset-timer;              sep 2
        widget 3 reset-timer absolute;     sep 3
        widget 4 weekly-usage;             sep 4
        widget 5 weekly-reset-timer;       sep 5
        widget 6 weekly-reset-timer absolute
        printf '],[],[]]}'
    } > "$config"
    printf '{"session_id":"cc-usage","model":{"display_name":"-"},"cwd":"/"}' |
        if [ -n "${1:-}" ]; then
            CLAUDE_CONFIG_DIR=$1 bunx -y ccstatusline@latest --config "$config"
        else
            env -u CLAUDE_CONFIG_DIR bunx -y ccstatusline@latest --config "$config"
        fi 2>/dev/null | tail -1 | sed "s/$esc\[[0-9;]*m//g; s/$nbsp/ /g"
}

trim() { printf '%s' "$1" | sed 's/^ *//; s/ *$//'; }

# Reduce "2026-11-21 10:39 GMT+8" or "Sun 19:59 GMT+8" to local "10:39" / "Sun 19:59".
clock() { trim "$1" | sed -E 's/^[0-9]{4}-[0-9]{2}-[0-9]{2} //; s/([0-9]{2}:[0-9]{2}).*$/\1/'; }

bar() { # bar <percent>; 20 cells, coloured by level when printing to a terminal
    level=${1%%%}; level=${level%%.*}
    filled=$(( (level * 20 + 50) / 100 )); [ "$filled" -gt 20 ] && filled=20
    if [ "$level" -ge 80 ]; then colour=31; elif [ "$level" -ge 50 ]; then colour=33; else colour=32; fi
    [ -t 1 ] && printf '\033[%sm' "$colour"
    i=0; while [ "$i" -lt "$filled" ]; do printf '█'; i=$((i + 1)); done
    [ -t 1 ] && printf '\033[90m'
    while [ "$i" -lt 20 ]; do printf '░'; i=$((i + 1)); done
    [ -t 1 ] && printf '\033[0m'
    return 0
}

window() { # window <name> <percent> <time left> <resets at>
    pct=$(trim "$2")
    printf '  %-7s ' "$1"; bar "$pct"; printf ' %6s  ' "$pct"
    case $3 in
        *Loading*) printf 'no active window\n' ;;
        *)         printf 'resets in %s (%s)\n' "$(trim "$3")" "$(clock "$4")" ;;
    esac
}

for dir in "$HOME/.claude" "$HOME"/.claude-*; do
    [ -f "$dir/account-label" ] || continue
    # The default dir must run with CLAUDE_CONFIG_DIR unset: setting it, even
    # to ~/.claude, makes Claude tooling look up a different login.
    [ "$dir" = "$HOME/.claude" ] && arg= || arg=$dir
    line=$(usage_line "$arg")
    IFS='|' read -r s_pct s_left s_at w_pct w_left w_at <<EOF
$line
EOF
    printf '%s\n' "$(cat "$dir/account-label")"
    window 5h "$s_pct" "$s_left" "$s_at"
    window weekly "$w_pct" "$w_left" "$w_at"
done
